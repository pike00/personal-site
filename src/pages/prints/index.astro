---
export const prerender = true;
import PageLayout from "../../layouts/PageLayout.astro";
import SimpleLayout from "../../components/SimpleLayout.astro";
import { getPrints } from "../../lib/posts";

const prints = getPrints().sort(
  (a, b) => new Date(b.date).getTime() - new Date(a.date).getTime(),
);

const fmt = (d: string) =>
  new Date(d + "T00:00:00").toLocaleDateString("en-US", {
    year: "numeric",
    month: "short",
    day: "numeric",
  });
---

<PageLayout title="3D Prints" description="Things I've designed and printed.">
  <SimpleLayout
    title="3D Prints"
    intro="Parts I design in OpenSCAD and run off the printer. Each one has its own write-up: what it is for, how it works, and how it came out."
  >
    {prints.length === 0 ? (
      <p class="text-sm text-zinc-500 dark:text-zinc-400">Nothing here yet. Check back soon.</p>
    ) : (
      <div class="grid grid-cols-1 gap-8 sm:grid-cols-2">
        {prints.map((print) => (
          <a
            href={`/prints/${print.slug}`}
            class="group flex flex-col overflow-hidden rounded-2xl border border-zinc-100 bg-white transition hover:shadow-lg dark:border-zinc-700/40 dark:bg-zinc-800/50"
          >
            {print.image && (
              <div class="aspect-[4/3] overflow-hidden bg-zinc-50 dark:bg-zinc-900">
                <img
                  src={print.image}
                  alt={print.title}
                  loading="lazy"
                  class="h-full w-full object-cover transition duration-300 group-hover:scale-[1.02]"
                />
              </div>
            )}
            <div class="flex flex-1 flex-col p-5">
              <p class="text-xs text-zinc-400 dark:text-zinc-500">
                <time datetime={print.date}>{fmt(print.date)}</time>
              </p>
              <h2 class="mt-2 text-base font-semibold tracking-tight text-zinc-800 transition group-hover:text-violet-600 dark:text-zinc-100 dark:group-hover:text-violet-400">
                {print.title}
              </h2>
              <p class="mt-2 flex-1 text-sm text-zinc-600 dark:text-zinc-400">{print.description}</p>
              {print.tags.length > 0 && (
                <div class="mt-4 flex flex-wrap gap-1.5">
                  {print.tags.map((tag) => (
                    <span class="rounded-full bg-zinc-100 px-2 py-0.5 text-[10px] font-medium text-zinc-600 dark:bg-zinc-800 dark:text-zinc-400">
                      {tag}
                    </span>
                  ))}
                </div>
              )}
            </div>
          </a>
        ))}
      </div>
    )}
  </SimpleLayout>
</PageLayout>
