---
export const prerender = true;
import PageLayout from "../../layouts/PageLayout.astro";
import Container from "../../components/Container.astro";
import TopicPill from "../../components/TopicPill.astro";
import { getPublications } from "../../lib/publications";
import type { Publication } from "../../lib/types";
import { highlightAuthors } from "../../lib/authors";
import { formatCitation, toBibTeX, toRIS } from "../../lib/citations";
import { scholarlyArticleJsonLd } from "../../lib/jsonld";
import { readCitationCache, citationInfo } from "../../lib/citation-counts";

export function getStaticPaths() {
  const publications = getPublications();
  return publications.map((pub) => ({
    params: { slug: pub.slug },
    props: { publication: pub },
  }));
}

interface Props {
  publication: Publication;
}

const { publication: pub } = Astro.props;

// Build-time Semantic Scholar citation count (from the build:scholar cache).
// Renders nothing when the cache has no entry for this DOI.
const citation = citationInfo(readCitationCache(), pub.doi);

const pdfUrl = pub.pdfPath
  ? "/" + pub.pdfPath.split("/").map(encodeURIComponent).join("/")
  : undefined;

const authorDisplay = highlightAuthors(pub.authors);

const citations = {
  formatted: formatCitation(pub),
  bibtex: toBibTeX(pub),
  ris: toRIS(pub),
};

const year = pub.pubDate ? pub.pubDate.split("-")[0] : "";
const dateDisplay = pub.pubDate
  ? new Date(pub.pubDate + "T00:00:00").toLocaleDateString("en-US", {
      year: "numeric",
      month: "long",
      day: "numeric",
    })
  : "";
---

<PageLayout
  title={pub.title}
  description={`${pub.title}. ${pub.journal}${year ? `, ${year}` : ""}`}
  image={`/og/pub-${pub.slug}.png`}
  type="article"
  jsonLd={scholarlyArticleJsonLd(pub)}
>
  <Container variant="full" class="mt-16 lg:mt-32">
    <div class="mx-auto max-w-2xl">
      <a
        href="/publications"
        aria-label="Back to publications"
        class="group mb-8 flex h-10 w-10 items-center justify-center rounded-full bg-white shadow-md ring-1 shadow-zinc-800/5 ring-zinc-900/5 transition dark:border dark:border-zinc-700/50 dark:bg-zinc-800 dark:ring-0 dark:ring-white/10 dark:hover:border-zinc-700 dark:hover:ring-white/20"
      >
        <svg viewBox="0 0 16 16" fill="none" aria-hidden="true" class="h-4 w-4 stroke-zinc-500 transition group-hover:stroke-zinc-700 dark:stroke-zinc-500 dark:group-hover:stroke-zinc-400">
          <path d="M7.25 11.25 3.75 8m0 0 3.5-3.25M3.75 8h8.5" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
      </a>

      <h1 class="text-3xl font-bold leading-snug tracking-tight text-zinc-800 sm:text-4xl dark:text-zinc-100">
        {pub.title}
      </h1>

      {pub.authors.length > 0 && (
        <p class="mt-4 text-sm text-zinc-600 dark:text-zinc-300" set:html={authorDisplay} />
      )}

    {pub.journal && (
      <p class="text-sm text-zinc-500 dark:text-zinc-400 mb-6">
        <span class="italic">{pub.journal}</span>
        {pub.volume && `, ${pub.volume}`}
        {pub.issue && `(${pub.issue})`}
        {pub.pages && `: ${pub.pages}`}
        {year && ` (${year})`}
      </p>
    )}

    {citation && citation.count > 0 && (
      <p class="-mt-2 mb-6">
        <a
          href={citation.url?.startsWith("https://") ? citation.url : `https://doi.org/${pub.doi}`}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-1.5 rounded-full bg-violet-50 px-3 py-1 text-xs font-medium text-violet-700 ring-1 ring-violet-200 transition hover:bg-violet-100 dark:bg-violet-500/10 dark:text-violet-300 dark:ring-violet-500/20 dark:hover:bg-violet-500/20"
        >
          Cited by {citation.count}
          <span class="opacity-60">· Semantic Scholar</span>
        </a>
      </p>
    )}

    {pub.researchArea.length > 0 && (
      <div class="flex flex-wrap gap-2 mb-8">
        {pub.researchArea.map((tag) => (
          <TopicPill tag={tag} size="sm" />
        ))}
      </div>
    )}

    {pdfUrl && (
      <div class="mb-8">
        <a
          href={pdfUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 rounded-md bg-zinc-800 px-4 py-2 text-sm font-medium text-zinc-100 transition hover:bg-zinc-700 dark:bg-zinc-700 dark:hover:bg-zinc-600"
        >
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
          </svg>
          View PDF
          <svg class="w-3 h-3 opacity-60" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
          </svg>
        </a>
      </div>
    )}

    <div class="border-t border-zinc-200 dark:border-zinc-700 pt-6">
      <div class="flex items-center justify-between gap-4 mb-4">
        <h2 class="text-sm font-semibold text-zinc-500 dark:text-zinc-400 uppercase tracking-wider">Details</h2>
        <!-- Cite control: hover (or focus/tap) reveals the citation popover. -->
        <div class="group relative shrink-0">
          <button
            type="button"
            class="inline-flex items-center gap-1 text-xs font-medium text-violet-600 hover:text-violet-700 dark:text-violet-400 dark:hover:text-violet-300 cursor-pointer"
            aria-haspopup="true"
          >
            Cite
            <svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path d="M19 9l-7 7-7-7" />
            </svg>
          </button>
          <div
            class="invisible opacity-0 translate-y-1 group-hover:visible group-hover:opacity-100 group-hover:translate-y-0 group-focus-within:visible group-focus-within:opacity-100 group-focus-within:translate-y-0 transition duration-150 absolute right-0 top-full z-20 pt-2 w-[min(90vw,34rem)]"
          >
            <div class="bg-white dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-700 rounded-xl shadow-lg p-4 max-h-[70vh] overflow-y-auto text-left">
              <div class="flex items-center justify-between gap-4 mb-3">
                <span class="text-xs font-semibold text-zinc-500 dark:text-zinc-400 uppercase tracking-wider">Cite</span>
                <div class="flex gap-4 text-xs shrink-0">
                  <a href={`/publications/${pub.slug}.bib`} download class="text-violet-600 hover:underline dark:text-violet-400">Download .bib</a>
                  <a href={`/publications/${pub.slug}.ris`} download class="text-violet-600 hover:underline dark:text-violet-400">Download .ris</a>
                </div>
              </div>
              <div class="space-y-4">
                <div>
                  <p class="text-xs text-zinc-500 dark:text-zinc-400 mb-1">Formatted</p>
                  <code class="inline-copy block font-sans not-italic text-sm text-zinc-700 dark:text-zinc-300 leading-relaxed bg-zinc-100 dark:bg-zinc-800 rounded-lg p-3 cursor-pointer" title="Click to copy" role="button" tabindex="0">{citations.formatted}</code>
                </div>
                <div>
                  <p class="text-xs text-zinc-500 dark:text-zinc-400 mb-1">BibTeX</p>
                  <pre class="text-xs bg-zinc-100 dark:bg-zinc-800 rounded-lg p-3 overflow-x-auto"><code class="inline-copy cursor-pointer" title="Click to copy" role="button" tabindex="0">{citations.bibtex}</code></pre>
                </div>
                <div>
                  <p class="text-xs text-zinc-500 dark:text-zinc-400 mb-1">RIS</p>
                  <pre class="text-xs bg-zinc-100 dark:bg-zinc-800 rounded-lg p-3 overflow-x-auto"><code class="inline-copy cursor-pointer" title="Click to copy" role="button" tabindex="0">{citations.ris}</code></pre>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
      <dl class="grid grid-cols-[auto_1fr] gap-x-6 gap-y-3 text-sm">
        {pub.pubType && (
          <>
            <dt class="text-zinc-500 dark:text-zinc-400">Publication Type</dt>
            <dd class="text-zinc-800 dark:text-zinc-200">{pub.pubType}</dd>
          </>
        )}
        {pub.journal && (
          <>
            <dt class="text-zinc-500 dark:text-zinc-400">Journal</dt>
            <dd class="text-zinc-800 dark:text-zinc-200">{pub.journal}</dd>
          </>
        )}
        {pub.pubDate && (
          <>
            <dt class="text-zinc-500 dark:text-zinc-400">Date Published</dt>
            <dd class="text-zinc-800 dark:text-zinc-200">{dateDisplay}</dd>
          </>
        )}
        {pub.volume && (
          <>
            <dt class="text-zinc-500 dark:text-zinc-400">Volume</dt>
            <dd class="text-zinc-800 dark:text-zinc-200">{pub.volume}</dd>
          </>
        )}
        {pub.issue && (
          <>
            <dt class="text-zinc-500 dark:text-zinc-400">Issue</dt>
            <dd class="text-zinc-800 dark:text-zinc-200">{pub.issue}</dd>
          </>
        )}
        {pub.pages && (
          <>
            <dt class="text-zinc-500 dark:text-zinc-400">Pages</dt>
            <dd class="text-zinc-800 dark:text-zinc-200">{pub.pages}</dd>
          </>
        )}
        {pub.doi && (
          <>
            <dt class="text-zinc-500 dark:text-zinc-400">Digital Object Identifier</dt>
            <dd class="text-zinc-800 dark:text-zinc-200">
              <a
                href={`https://doi.org/${pub.doi}`}
                target="_blank"
                rel="noopener noreferrer"
                class="text-violet-600 hover:underline dark:text-violet-400 inline-flex items-center gap-1"
              >
                {pub.doi}
                <svg class="w-3 h-3 opacity-60" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
                </svg>
              </a>
            </dd>
          </>
        )}
        {pub.id && (
          <>
            <dt class="text-zinc-500 dark:text-zinc-400">PubMed Identifier</dt>
            <dd class="text-zinc-800 dark:text-zinc-200">
              <a
                href={`https://pubmed.ncbi.nlm.nih.gov/${pub.id}/`}
                target="_blank"
                rel="noopener noreferrer"
                class="text-violet-600 hover:underline dark:text-violet-400 inline-flex items-center gap-1"
              >
                {pub.id}
                <svg class="w-3 h-3 opacity-60" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
                </svg>
              </a>
            </dd>
          </>
        )}
        {pub.pmcId && (
          <>
            <dt class="text-zinc-500 dark:text-zinc-400">PubMed Central Identifier</dt>
            <dd class="text-zinc-800 dark:text-zinc-200">
              <a
                href={`https://www.ncbi.nlm.nih.gov/pmc/articles/${pub.pmcId}/`}
                target="_blank"
                rel="noopener noreferrer"
                class="text-violet-600 hover:underline dark:text-violet-400 inline-flex items-center gap-1"
              >
                {pub.pmcId}
                <svg class="w-3 h-3 opacity-60" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
                </svg>
              </a>
            </dd>
          </>
        )}
      </dl>
    </div>

    {pdfUrl && (
      <div class="border-t border-zinc-200 dark:border-zinc-700 pt-6 mt-8">
        <h2 class="text-sm font-semibold text-zinc-500 dark:text-zinc-400 uppercase tracking-wider mb-4">Document Preview</h2>
        <div class="hidden md:block rounded-xl border border-zinc-200 dark:border-zinc-700 overflow-hidden bg-zinc-100 dark:bg-zinc-800">
          <iframe
            src={pdfUrl}
            class="w-full"
            style="height: 80vh; min-height: 600px;"
            title={`PDF preview of ${pub.title}`}
          >
            <p class="p-6 text-sm text-zinc-500">
              Your browser does not support embedded PDFs.
              <a href={pdfUrl} target="_blank" rel="noopener noreferrer" class="text-violet-600 hover:underline dark:text-violet-400">
                Open the PDF directly.
              </a>
            </p>
          </iframe>
        </div>
        <a
          href={pdfUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="md:hidden inline-flex items-center gap-2 text-violet-600 hover:underline dark:text-violet-400 text-sm"
        >
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
          </svg>
          Open PDF
          <svg class="w-3 h-3 opacity-60" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
          </svg>
        </a>
      </div>
    )}
    </div>
  </Container>
  <script is:inline src="/js/copy-code.js" defer></script>
</PageLayout>
