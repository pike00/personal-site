---
export const prerender = true;
import PageLayout from "../layouts/PageLayout.astro";
import Container from "../components/Container.astro";
import fs from "node:fs";
import path from "node:path";
import { marked } from "marked";

// Mirrors now.astro / about.astro: strip frontmatter, render the body with the
// shared `marked` instance (single synchronous parse, no marked-footnote).
const usesPath = path.resolve("src/content/uses.md");
const raw = fs.readFileSync(usesPath, "utf-8");
const body = raw.replace(/^---[\s\S]*?---\n/, "");
const htmlContent = await marked.parse(body);
---

<PageLayout title="Uses" description="The hardware and software Will Pike uses.">
  <Container variant="full" class="mt-16 sm:mt-32">
    <div class="mx-auto max-w-2xl">
      <h1 class="text-4xl font-bold tracking-tight text-zinc-800 sm:text-5xl dark:text-zinc-100">
        What I use
      </h1>
      <article
        class="prose mt-6 max-w-none dark:prose-invert"
        set:html={htmlContent}
      />
    </div>
  </Container>
</PageLayout>
