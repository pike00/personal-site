---
export const prerender = true;
import PageLayout from "../../layouts/PageLayout.astro";
import TopicPill from "../../components/TopicPill.astro";
import fs from "node:fs";
import path from "node:path";
import matter from "gray-matter";
import { Marked } from "marked";
import markedFootnote from "marked-footnote";
import { codeToHtml } from "shiki";

interface PostFrontmatter {
  title: string;
  description: string;
  date: string;
  tags: string[];
  draft?: boolean;
}

interface PostData extends PostFrontmatter {
  bodyHtml: string;
}

interface StaticPath {
  params: { slug: string };
  props: { post: PostData };
}

export async function getStaticPaths(): Promise<StaticPath[]> {
  // Fresh Marked per post: marked-footnote keeps shared closure state that
  // races under Promise.all otherwise.
  const makeMarked = () =>
    new Marked({
      async: true,
      async walkTokens(token) {
        if (token.type === "code") {
          (token as { html?: string }).html = await codeToHtml(token.text, {
            lang: token.lang || "text",
            theme: "github-dark",
          });
        }
      },
    })
      .use({
        renderer: {
          code(token) {
            return (
              (token as { html?: string }).html ||
              `<pre><code>${token.text}</code></pre>`
            );
          },
        },
      })
      .use(markedFootnote());

  const blogDir = path.resolve("blog-posts/posts");
  if (!fs.existsSync(blogDir)) return [];

  const files: string[] = fs
    .readdirSync(blogDir)
    .filter((f: string) => f.endsWith(".md"));

  const paths = await Promise.all(
    files.map(async (file: string): Promise<StaticPath | null> => {
      const slug = file.replace(/\.md$/, "");
      const raw = fs.readFileSync(path.join(blogDir, file), "utf-8");
      const { data, content } = matter(raw);
      if ((data as PostFrontmatter & { draft?: boolean }).draft) return null;
      const bodyHtml = await makeMarked().parse(content);
      return {
        params: { slug },
        props: {
          post: {
            ...(data as PostFrontmatter),
            bodyHtml,
          },
        },
      };
    }),
  );
  return paths.filter((p): p is StaticPath => p !== null);
}

interface Props {
  post: PostData;
}

const { post } = Astro.props;

const dateDisplay = new Date(post.date + "T00:00:00").toLocaleDateString("en-US", {
  year: "numeric",
  month: "long",
  day: "numeric",
});
---

<PageLayout title={post.title} description={post.description} image={`/og/blog-${Astro.params.slug}.png`}>
  <div class="max-w-3xl mx-auto px-6 py-12">
    <nav class="text-sm text-gray-400 dark:text-gray-500 mb-8">
      <a href="/blog" class="hover:text-accent transition-colors">Blog</a>
      <span class="mx-2">/</span>
      <span class="text-gray-600 dark:text-gray-300">{post.title}</span>
    </nav>

    <h1 class="text-2xl font-bold text-primary dark:text-white mb-3">{post.title}</h1>
    <p class="text-xs text-gray-400 dark:text-gray-500 mb-4">{dateDisplay}</p>

    {post.tags.length > 0 && (
      <div class="flex flex-wrap gap-2 mb-8">
        {post.tags.map((tag: string) => (
          <TopicPill tag={tag} size="sm" />
        ))}
      </div>
    )}

    <article
      class="prose prose-sm dark:prose-invert max-w-none prose-headings:text-primary dark:prose-headings:text-white prose-a:text-accent"
      set:html={post.bodyHtml}
    />
  </div>
</PageLayout>
