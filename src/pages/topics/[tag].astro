---
export const prerender = true;
import PageLayout from "../../layouts/PageLayout.astro";
import SimpleLayout from "../../components/SimpleLayout.astro";
import PublicationCard from "../../components/PublicationCard.astro";
import FeedCard from "../../components/FeedCard.astro";
import { getPairedPostSlug } from "../../lib/pairings";
import { getAllTopics, type TopicData } from "../../lib/tags";

export function getStaticPaths() {
  return getAllTopics().map((topic) => ({
    params: { tag: topic.slug },
    props: { topic },
  }));
}

interface Props {
  topic: TopicData;
}

const { topic } = Astro.props;

const feedPosts = topic.posts.filter((post) => !post.hideFromFeed);
const activePostSlugs = new Set(feedPosts.map((p) => p.slug));
const feedProjects = topic.projects.filter((proj) => {
  if (proj.hideFromFeed) return false;
  const pairedPostSlug = getPairedPostSlug(proj.slug);
  if (pairedPostSlug && activePostSlugs.has(pairedPostSlug)) return false;
  return true;
});

const feedEntries = [
  ...feedPosts.map((p) => ({ type: "post" as const, ...p })),
  ...feedProjects.map((p) => ({ type: "project" as const, ...p })),
].sort((a, b) => new Date(b.date).getTime() - new Date(a.date).getTime());

const total = topic.publications.length + feedEntries.length;
const noun = total === 1 ? "item" : "items";
---

<PageLayout
  title={`${topic.tag}`}
  description={`Publications, notes, and projects tagged ${topic.tag}.`}
>
  <SimpleLayout title={topic.tag} intro={`${total} ${noun} tagged ${topic.tag}.`}>
    {topic.publications.length > 0 && (
      <section class="mb-12">
        <h2 class="mb-5 text-sm font-semibold uppercase tracking-wider text-zinc-500 dark:text-zinc-400">
          Publications
        </h2>
        <div class="flex flex-col gap-3">
          {topic.publications.map((pub) => (
            <PublicationCard publication={pub} />
          ))}
        </div>
      </section>
    )}

    {feedEntries.length > 0 && (
      <section>
        <h2 class="mb-6 text-sm font-semibold uppercase tracking-wider text-zinc-500 dark:text-zinc-400">
          Notes &amp; Projects
        </h2>
        <div class="md:border-l md:border-zinc-100 md:pl-6 md:dark:border-zinc-700/40">
          <div class="flex max-w-3xl flex-col space-y-16">
            {feedEntries.map((entry) => (
              <FeedCard
                type={entry.type}
                slug={entry.slug}
                title={entry.title}
                description={entry.description}
                date={entry.date}
                tags={entry.tags}
              />
            ))}
          </div>
        </div>
      </section>
    )}
  </SimpleLayout>
</PageLayout>
