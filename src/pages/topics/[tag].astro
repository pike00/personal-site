---
export const prerender = true;
import PageLayout from "../../layouts/PageLayout.astro";
import SimpleLayout from "../../components/SimpleLayout.astro";
import PublicationCard from "../../components/PublicationCard.astro";
import FeedCard from "../../components/FeedCard.astro";
import { getAllTopics, type TopicData } from "../../lib/tags";

export function getStaticPaths() {
  return getAllTopics().map((topic) => ({
    params: { tag: topic.slug },
    props: { topic },
  }));
}

interface Props {
  topic: TopicData;
}

const { topic } = Astro.props;
const total =
  topic.publications.length + topic.posts.length + topic.projects.length;
const noun = total === 1 ? "item" : "items";
---

<PageLayout
  title={`${topic.tag}`}
  description={`Publications, notes, and projects tagged ${topic.tag}.`}
>
  <SimpleLayout title={topic.tag} intro={`${total} ${noun} tagged ${topic.tag}.`}>
    {topic.publications.length > 0 && (
      <section class="mb-12">
        <h2 class="mb-5 text-sm font-semibold uppercase tracking-wider text-zinc-500 dark:text-zinc-400">
          Publications
        </h2>
        <div class="flex flex-col gap-3">
          {topic.publications.map((pub) => (
            <PublicationCard publication={pub} />
          ))}
        </div>
      </section>
    )}

    {(topic.posts.length > 0 || topic.projects.length > 0) && (
      <section>
        <h2 class="mb-6 text-sm font-semibold uppercase tracking-wider text-zinc-500 dark:text-zinc-400">
          Notes &amp; Projects
        </h2>
        <div class="md:border-l md:border-zinc-100 md:pl-6 md:dark:border-zinc-700/40">
          <div class="flex max-w-3xl flex-col space-y-16">
            {topic.posts.map((post) => (
              <FeedCard
                type="post"
                slug={post.slug}
                title={post.title}
                description={post.description}
                date={post.date}
                tags={post.tags}
              />
            ))}
            {topic.projects.map((project) => (
              <FeedCard
                type="project"
                slug={project.slug}
                title={project.title}
                description={project.description}
                date={project.date}
                tags={project.tags}
              />
            ))}
          </div>
        </div>
      </section>
    )}
  </SimpleLayout>
</PageLayout>
