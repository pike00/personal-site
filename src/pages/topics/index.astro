---
export const prerender = true;
import PageLayout from "../../layouts/PageLayout.astro";
import SimpleLayout from "../../components/SimpleLayout.astro";
import { getAllTopics } from "../../lib/tags";

const topics = getAllTopics();

// Per-topic count summary, e.g. "3 publications · 1 note".
function summarize(t: (typeof topics)[number]): string {
  const parts: string[] = [];
  const add = (n: number, singular: string) =>
    n > 0 && parts.push(`${n} ${singular}${n === 1 ? "" : "s"}`);
  add(t.publications.length, "publication");
  add(t.posts.length, "note");
  add(t.projects.length, "project");
  return parts.join(" · ");
}
---

<PageLayout
  title="Topics"
  description="Browse publications, notes, and projects by research area and topic."
>
  <SimpleLayout
    title="Topics"
    intro={`${topics.length} topic${topics.length === 1 ? "" : "s"} across publications, notes, and projects.`}
  >
    <div class="grid gap-3 sm:grid-cols-2">
      {topics.map((topic) => (
        <a
          href={`/topics/${topic.slug}`}
          class="group flex items-center justify-between gap-4 rounded-2xl border border-zinc-100 p-5 transition hover:border-zinc-200 hover:bg-zinc-50/60 dark:border-zinc-700/40 dark:hover:border-zinc-700 dark:hover:bg-zinc-800/40"
        >
          <div class="min-w-0">
            <div class="truncate text-sm font-semibold text-zinc-800 transition-colors group-hover:text-violet-600 dark:text-zinc-100 dark:group-hover:text-violet-400">
              {topic.tag}
            </div>
            <div class="mt-0.5 text-xs text-zinc-400 dark:text-zinc-500">
              {summarize(topic)}
            </div>
          </div>
          <svg class="h-4 w-4 shrink-0 text-zinc-400 transition-colors group-hover:text-violet-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
          </svg>
        </a>
      ))}
    </div>
  </SimpleLayout>
</PageLayout>
