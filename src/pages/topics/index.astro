---
export const prerender = true;
import PageLayout from "../../layouts/PageLayout.astro";
import { getAllTopics } from "../../lib/tags";

const topics = getAllTopics();

// Per-topic count summary, e.g. "3 publications · 1 note".
function summarize(t: (typeof topics)[number]): string {
  const parts: string[] = [];
  const add = (n: number, singular: string) =>
    n > 0 && parts.push(`${n} ${singular}${n === 1 ? "" : "s"}`);
  add(t.publications.length, "publication");
  add(t.posts.length, "note");
  add(t.projects.length, "project");
  return parts.join(" · ");
}
---

<PageLayout
  title="Topics"
  description="Browse publications, notes, and projects by research area and topic."
>
  <div class="max-w-4xl mx-auto px-6 py-12">
    <nav class="text-sm text-gray-400 dark:text-gray-500 mb-8">
      <a href="/" class="hover:text-accent transition-colors">Home</a>
      <span class="mx-2">/</span>
      <span class="text-gray-600 dark:text-gray-300">Topics</span>
    </nav>

    <h1 class="text-2xl font-bold text-primary dark:text-white mb-1">Topics</h1>
    <p class="text-sm text-gray-500 dark:text-gray-400 mb-10">
      {topics.length} topic{topics.length === 1 ? "" : "s"} across publications, notes, and projects
    </p>

    <div class="grid gap-3 sm:grid-cols-2">
      {topics.map((topic) => (
        <a
          href={`/topics/${topic.slug}`}
          class="group flex items-center justify-between gap-4 p-5 bg-white dark:bg-surface-card-dark border border-gray-200 dark:border-gray-700 rounded-lg hover:shadow-md hover:border-accent/50 transition-all"
        >
          <div class="min-w-0">
            <div class="text-sm font-semibold text-primary dark:text-white group-hover:text-accent transition-colors truncate">
              {topic.tag}
            </div>
            <div class="text-xs text-gray-400 dark:text-gray-500 mt-0.5">
              {summarize(topic)}
            </div>
          </div>
          <svg class="w-4 h-4 text-gray-400 group-hover:text-accent transition-colors shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
          </svg>
        </a>
      ))}
    </div>
  </div>
</PageLayout>
