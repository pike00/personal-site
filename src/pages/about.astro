---
export const prerender = true;
import { Image } from "astro:assets";
import familyPhoto from "../assets/family.jpeg";
import PageLayout from "../layouts/PageLayout.astro";
import Container from "../components/Container.astro";
import fs from "node:fs";
import path from "node:path";
import { marked } from "marked";

const aboutPath = path.resolve("src/content/about.md");
const aboutContent = fs.readFileSync(aboutPath, "utf-8");
const contentWithoutFrontmatter = aboutContent.replace(/^---[\s\S]*?---\n/, "");
const htmlContent = await marked.parse(contentWithoutFrontmatter);

---

<PageLayout title="About" description="About Will Pike, physician and researcher.">
  <Container variant="full" class="mt-16 sm:mt-32">
    <div class="grid grid-cols-1 gap-y-16 lg:grid-cols-2 lg:grid-rows-[auto_1fr] lg:gap-y-12">
      <div class="lg:pl-20">
        <div class="max-w-xs px-2.5 lg:max-w-none">
          <Image
            src={familyPhoto}
            alt="Will and Aleisha with their whippets Bleu and Sammy"
            class="aspect-square rounded-2xl bg-zinc-100 object-cover shadow-xl dark:bg-zinc-800"
          />
        </div>
      </div>
      <div class="lg:order-first lg:row-span-2">
        <h1 class="text-4xl font-bold tracking-tight text-zinc-800 sm:text-5xl dark:text-zinc-100">
          About me
        </h1>
        <article
          class="prose mt-6 max-w-none dark:prose-invert"
          set:html={htmlContent}
        />
        <div class="mt-10 border-t border-zinc-100 pt-10 dark:border-zinc-700/40">
          <h2 class="text-lg font-semibold text-zinc-800 dark:text-zinc-100">The family</h2>
          <p class="mt-3 text-base leading-relaxed text-zinc-600 dark:text-zinc-400">
            We live in Chicago, IL. When I'm not buried in manuscripts, I'm at home
            with my wife Aleisha and our two whippets, Bleu and Sammy. They keep us
            busy, entertained, and well-exercised.
          </p>
        </div>
      </div>
    </div>
  </Container>
</PageLayout>
