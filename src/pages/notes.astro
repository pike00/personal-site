---
export const prerender = true;
import PageLayout from "../layouts/PageLayout.astro";
import SimpleLayout from "../components/SimpleLayout.astro";
import FeedCard from "../components/FeedCard.astro";
import fs from "node:fs";
import path from "node:path";
import { matter } from "../lib/frontmatter";

interface FeedEntry {
  type: "post" | "project" | "print";
  slug: string;
  title: string;
  description: string;
  date: string;
  tags: string[];
  draft?: boolean;
}

const blogDir = path.resolve("blog-posts/posts");
const projectsDir = path.resolve("src/content/projects");
const printsDir = path.resolve("src/content/prints");

const posts: FeedEntry[] = (fs.existsSync(blogDir) ? fs.readdirSync(blogDir) : [])
  .filter((f: string) => f.endsWith(".md"))
  .map((file: string): FeedEntry => {
    const slug = file.replace(/\.md$/, "");
    const raw = fs.readFileSync(path.join(blogDir, file), "utf-8");
    const { data } = matter(raw);
    return {
      type: "post",
      slug,
      title: data.title,
      description: data.description,
      date: data.date,
      tags: data.tags ?? [],
      draft: data.draft,
    };
  })
  .filter((p: FeedEntry) => !p.draft);

const projects: FeedEntry[] = (fs.existsSync(projectsDir) ? fs.readdirSync(projectsDir) : [])
  .filter((f: string) => f.endsWith(".md"))
  .map((file: string): FeedEntry => {
    const slug = file.replace(/\.md$/, "");
    const raw = fs.readFileSync(path.join(projectsDir, file), "utf-8");
    const { data } = matter(raw);
    return {
      type: "project",
      slug,
      title: data.title,
      description: data.description,
      date: data.date,
      tags: data.tags ?? [],
    };
  });

const prints: FeedEntry[] = (fs.existsSync(printsDir) ? fs.readdirSync(printsDir) : [])
  .filter((f: string) => f.endsWith(".md"))
  .map((file: string): FeedEntry => {
    const slug = file.replace(/\.md$/, "");
    const raw = fs.readFileSync(path.join(printsDir, file), "utf-8");
    const { data } = matter(raw);
    return {
      type: "print",
      slug,
      title: data.title,
      description: data.description,
      date: data.date,
      tags: data.tags ?? [],
    };
  });

const entries: FeedEntry[] = [...posts, ...projects, ...prints].sort(
  (a, b) => new Date(b.date).getTime() - new Date(a.date).getTime(),
);
---

<PageLayout title="Notes" description="Writing and projects from Will Pike.">
  <SimpleLayout title="Notes" intro="Notes, tools, and projects — long-form writing alongside the things I've built.">
    {entries.length === 0 ? (
      <p class="text-sm text-zinc-500 dark:text-zinc-400">Nothing here yet. Check back soon.</p>
    ) : (
      <div class="md:border-l md:border-zinc-100 md:pl-6 md:dark:border-zinc-700/40">
        <div class="flex max-w-3xl flex-col space-y-16">
          {entries.map((entry: FeedEntry) => (
            <FeedCard
              type={entry.type}
              slug={entry.slug}
              title={entry.title}
              description={entry.description}
              date={entry.date}
              tags={entry.tags}
            />
          ))}
        </div>
      </div>
    )}
  </SimpleLayout>
</PageLayout>
