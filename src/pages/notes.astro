---
export const prerender = true;
import PageLayout from "../layouts/PageLayout.astro";
import SimpleLayout from "../components/SimpleLayout.astro";
import FeedCard from "../components/FeedCard.astro";
import { getCombinedFeed, type FeedEntry } from "../lib/feed";

const entries = getCombinedFeed();
---

<PageLayout title="Notes" description="Writing and projects from Will Pike.">
  <SimpleLayout title="Notes" intro="Notes, tools, and projects — long-form writing alongside the things I've built.">
    {entries.length === 0 ? (
      <p class="text-sm text-zinc-500 dark:text-zinc-400">Nothing here yet. Check back soon.</p>
    ) : (
      <div class="md:border-l md:border-zinc-100 md:pl-6 md:dark:border-zinc-700/40">
        <div class="flex max-w-3xl flex-col space-y-16">
          {entries.map((entry: FeedEntry) => (
            <FeedCard
              type={entry.type}
              slug={entry.slug}
              title={entry.title}
              description={entry.description}
              date={entry.date}
              tags={entry.tags}
            />
          ))}
        </div>
      </div>
    )}
  </SimpleLayout>
</PageLayout>
