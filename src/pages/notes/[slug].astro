---
export const prerender = true;
import PageLayout from "../../layouts/PageLayout.astro";
import TopicPill from "../../components/TopicPill.astro";
import { Marked } from "marked";
import markedFootnote from "marked-footnote";
import { codeToHtml } from "shiki";
import { getPairedProject } from "../../lib/pairings";
import { getPosts, readingTimeMinutes, type PostFrontmatter } from "../../lib/posts";

interface PostData extends PostFrontmatter {
  bodyHtml: string;
  readingMinutes: number;
}

interface StaticPath {
  params: { slug: string };
  props: { post: PostData };
}

export async function getStaticPaths(): Promise<StaticPath[]> {
  // Fresh Marked per post: marked-footnote keeps shared closure state that
  // races under Promise.all otherwise.
  const makeMarked = () =>
    new Marked({
      async: true,
      async walkTokens(token) {
        if (token.type === "code") {
          (token as { html?: string }).html = await codeToHtml(token.text, {
            lang: token.lang || "text",
            theme: "github-dark",
          });
        }
      },
    })
      .use({
        renderer: {
          code(token) {
            return (
              (token as { html?: string }).html ||
              `<pre><code>${token.text}</code></pre>`
            );
          },
          codespan(token) {
            return `<code class="inline-copy" title="Click to copy" role="button" tabindex="0">${token.text}</code>`;
          },
        },
      })
      .use(markedFootnote());

  const paths = await Promise.all(
    getPosts().map(async (post): Promise<StaticPath> => {
      const bodyHtml = await makeMarked().parse(post.content);
      return {
        params: { slug: post.slug },
        props: {
          post: {
            title: post.title,
            description: post.description,
            date: post.date,
            tags: post.tags,
            draft: post.draft,
            bodyHtml,
            readingMinutes: readingTimeMinutes(post.content),
          },
        },
      };
    }),
  );
  return paths;
}

interface Props {
  post: PostData;
}

const { post } = Astro.props;

const dateDisplay = new Date(post.date + "T00:00:00").toLocaleDateString("en-US", {
  year: "numeric",
  month: "long",
  day: "numeric",
});

const pairedProject = getPairedProject(Astro.params.slug as string);
---

<PageLayout title={post.title} description={post.description} image={`/og/blog-${Astro.params.slug}.png`}>
  <div class="max-w-3xl mx-auto px-6 py-12">
    <nav class="text-sm text-gray-400 dark:text-gray-500 mb-8">
      <a href="/notes" class="hover:text-accent transition-colors">Notes</a>
      <span class="mx-2">/</span>
      <span class="text-gray-600 dark:text-gray-300">{post.title}</span>
    </nav>

    <h1 class="text-2xl font-bold text-primary dark:text-white mb-3">{post.title}</h1>
    <p class="text-xs text-gray-400 dark:text-gray-500 mb-4">{dateDisplay} &middot; {post.readingMinutes} min read</p>

    {post.tags.length > 0 && (
      <div class="flex flex-wrap gap-2 mb-8">
        {post.tags.map((tag: string) => (
          <TopicPill tag={tag} size="sm" />
        ))}
      </div>
    )}

    {pairedProject && (
      <aside class="not-prose mb-8 p-4 border-l-4 border-accent bg-accent/5 dark:bg-accent/10 rounded-r-lg">
        <p class="text-[10px] font-semibold uppercase tracking-wider text-accent mb-1">Related project</p>
        <a href={`/projects/${pairedProject.slug}`} class="text-sm font-semibold text-primary dark:text-gray-100 hover:text-accent dark:hover:text-accent transition-colors">
          {pairedProject.title} &rarr;
        </a>
        <p class="text-xs text-gray-500 dark:text-gray-400 mt-1 leading-relaxed">{pairedProject.description}</p>
      </aside>
    )}

    <article
      class="prose prose-sm dark:prose-invert max-w-none prose-headings:text-primary dark:prose-headings:text-white prose-a:text-accent prose-code:before:content-none prose-code:after:content-none"
      set:html={post.bodyHtml}
    />
  </div>
  <script is:inline src="/js/copy-code.js" defer></script>
</PageLayout>
