---
export const prerender = true;
import PageLayout from "../../layouts/PageLayout.astro";
import Container from "../../components/Container.astro";
import TopicPill from "../../components/TopicPill.astro";
import { Marked } from "marked";
import markedFootnote from "marked-footnote";
import { codeToHtml } from "shiki";
import { getPairedProject } from "../../lib/pairings";
import { getPosts, readingTimeMinutes, type PostFrontmatter } from "../../lib/posts";

export interface TocItem {
  id: string;
  text: string;
  depth: number;
}

export function extractToc(content: string): TocItem[] {
  const items: TocItem[] = [];
  const lines = content.split("\n");
  let inCode = false;

  for (const line of lines) {
    if (line.trim().startsWith("```")) {
      inCode = !inCode;
      continue;
    }
    if (inCode) continue;

    const match = line.match(/^(#{2,3})\s+(.+)$/);
    if (match) {
      const depth = match[1].length;
      const rawText = match[2].trim().replace(/\[([^\]]+)\]\([^)]+\)/g, "$1");
      const id = rawText
        .toLowerCase()
        .replace(/[^a-z0-9]+/g, "-")
        .replace(/^-|-$/g, "");
      items.push({ id, text: rawText, depth });
    }
  }

  return items;
}

interface PostData extends PostFrontmatter {
  bodyHtml: string;
  readingMinutes: number;
  toc: TocItem[];
}

interface StaticPath {
  params: { slug: string };
  props: { post: PostData };
}

export async function getStaticPaths(): Promise<StaticPath[]> {
  // Fresh Marked per post: marked-footnote keeps shared closure state that
  // races under Promise.all otherwise.
  const makeMarked = () =>
    new Marked({
      async: true,
      async walkTokens(token) {
        if (token.type === "code") {
          (token as { html?: string }).html = await codeToHtml(token.text, {
            lang: token.lang || "text",
            theme: "github-dark",
          });
        }
      },
    })
      .use({
        renderer: {
          heading(token) {
            const rawText = token.text.replace(/\[([^\]]+)\]\([^)]+\)/g, "$1");
            const id = rawText
              .toLowerCase()
              .replace(/[^a-z0-9]+/g, "-")
              .replace(/^-|-$/g, "");
            return `<h${token.depth} id="${id}">${token.text}</h${token.depth}>`;
          },
          code(token) {
            return (
              (token as { html?: string }).html ||
              `<pre><code>${token.text}</code></pre>`
            );
          },
          codespan(token) {
            const escaped = token.text
              .replace(/&/g, "&amp;")
              .replace(/</g, "&lt;")
              .replace(/>/g, "&gt;")
              .replace(/"/g, "&quot;")
              .replace(/'/g, "&#39;");
            return `<code class="inline-copy" title="Click to copy" role="button" tabindex="0">${escaped}</code>`;
          },
        },
      })
      .use(markedFootnote());

  const paths = await Promise.all(
    getPosts().map(async (post): Promise<StaticPath> => {
      const bodyHtml = await makeMarked().parse(post.content);
      const toc = extractToc(post.content);
      return {
        params: { slug: post.slug },
        props: {
          post: {
            title: post.title,
            description: post.description,
            date: post.date,
            tags: post.tags,
            draft: post.draft,
            bodyHtml,
            readingMinutes: readingTimeMinutes(post.content),
            toc,
          },
        },
      };
    }),
  );
  return paths;
}

interface Props {
  post: PostData;
}

const { post } = Astro.props;

const dateDisplay = new Date(post.date + "T00:00:00").toLocaleDateString("en-US", {
  year: "numeric",
  month: "long",
  day: "numeric",
});

const pairedProject = getPairedProject(Astro.params.slug as string);
---

<PageLayout title={post.title} description={post.description} image={`/og/note-${Astro.params.slug}.png`}>
  <Container variant="full" class="mt-16 lg:mt-32">
    <div class="xl:relative">
      <div class="mx-auto max-w-2xl">
        <a
          href="/notes"
          aria-label="Back to notes"
          class="group mb-8 flex h-10 w-10 items-center justify-center rounded-full bg-white shadow-md ring-1 shadow-zinc-800/5 ring-zinc-900/5 transition lg:absolute lg:-left-5 lg:-mt-2 lg:mb-0 xl:-top-1.5 xl:left-0 xl:mt-0 dark:border dark:border-zinc-700/50 dark:bg-zinc-800 dark:ring-0 dark:ring-white/10 dark:hover:border-zinc-700 dark:hover:ring-white/20"
        >
          <svg viewBox="0 0 16 16" fill="none" aria-hidden="true" class="h-4 w-4 stroke-zinc-500 transition group-hover:stroke-zinc-700 dark:stroke-zinc-500 dark:group-hover:stroke-zinc-400">
            <path d="M7.25 11.25 3.75 8m0 0 3.5-3.25M3.75 8h8.5" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </a>

        <article>
          <header class="flex flex-col">
            <h1 class="mt-6 text-4xl font-bold tracking-tight text-zinc-800 sm:text-5xl dark:text-zinc-100">
              {post.title}
            </h1>
            <p class="order-first flex items-center text-base text-zinc-400 dark:text-zinc-500">
              <span class="h-4 w-0.5 rounded-full bg-zinc-200 dark:bg-zinc-500"></span>
              <span class="ml-3">{dateDisplay} &middot; {post.readingMinutes} min read</span>
            </p>
          </header>

          {post.tags.length > 0 && (
            <div class="mt-6 flex flex-wrap gap-2">
              {post.tags.map((tag: string) => (
                <TopicPill tag={tag} size="sm" />
              ))}
            </div>
          )}

          {pairedProject && (
            <aside class="mt-8 rounded-r-lg border-l-4 border-violet-500 bg-violet-500/5 p-4 dark:border-violet-400 dark:bg-violet-400/10">
              <p class="mb-1 text-[10px] font-semibold uppercase tracking-wider text-violet-600 dark:text-violet-400">Related project</p>
              <a href={`/projects/${pairedProject.slug}`} class="text-sm font-semibold text-zinc-800 transition-colors hover:text-violet-600 dark:text-zinc-100 dark:hover:text-violet-400">
                {pairedProject.title} &rarr;
              </a>
              <p class="mt-1 text-xs leading-relaxed text-zinc-500 dark:text-zinc-400">{pairedProject.description}</p>
            </aside>
          )}

          {post.toc.length >= 2 && (
            <nav class="mt-8 rounded-2xl border border-zinc-100 bg-zinc-50/50 p-5 dark:border-zinc-800 dark:bg-zinc-800/40">
              <h2 class="mb-3 text-xs font-semibold uppercase tracking-wider text-zinc-500 dark:text-zinc-400">
                Table of Contents
              </h2>
              <ol class="space-y-1.5 text-sm">
                {post.toc.map((item) => (
                  <li class={item.depth === 3 ? "pl-4 text-xs" : ""}>
                    <a
                      href={`#${item.id}`}
                      class="text-zinc-600 transition-colors hover:text-violet-600 dark:text-zinc-400 dark:hover:text-violet-400"
                    >
                      {item.text}
                    </a>
                  </li>
                ))}
              </ol>
            </nav>
          )}

          <article
            class="prose mt-8 max-w-none dark:prose-invert prose-code:before:content-none prose-code:after:content-none prose-img:rounded-lg prose-img:shadow-md prose-img:cursor-zoom-in"
            set:html={post.bodyHtml}
          />
        </article>
      </div>
    </div>
  </Container>
  <script is:inline src="/js/copy-code.js" defer></script>
  <script is:inline src="/js/image-zoom.js" defer></script>
</PageLayout>
