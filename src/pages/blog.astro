---
export const prerender = true;
import PageLayout from "../layouts/PageLayout.astro";
import FeedCard from "../components/FeedCard.astro";
import fs from "node:fs";
import path from "node:path";
import matter from "gray-matter";

interface FeedEntry {
  type: "post" | "project";
  slug: string;
  title: string;
  description: string;
  date: string;
  tags: string[];
  draft?: boolean;
}

const blogDir = path.resolve("blog-posts/posts");
const projectsDir = path.resolve("src/content/projects");

const posts: FeedEntry[] = (fs.existsSync(blogDir) ? fs.readdirSync(blogDir) : [])
  .filter((f: string) => f.endsWith(".md"))
  .map((file: string): FeedEntry => {
    const slug = file.replace(/\.md$/, "");
    const raw = fs.readFileSync(path.join(blogDir, file), "utf-8");
    const { data } = matter(raw);
    return {
      type: "post",
      slug,
      title: data.title,
      description: data.description,
      date: data.date,
      tags: data.tags ?? [],
      draft: data.draft,
    };
  })
  .filter((p: FeedEntry) => !p.draft);

const projects: FeedEntry[] = (fs.existsSync(projectsDir) ? fs.readdirSync(projectsDir) : [])
  .filter((f: string) => f.endsWith(".md"))
  .map((file: string): FeedEntry => {
    const slug = file.replace(/\.md$/, "");
    const raw = fs.readFileSync(path.join(projectsDir, file), "utf-8");
    const { data } = matter(raw);
    return {
      type: "project",
      slug,
      title: data.title,
      description: data.description,
      date: data.date,
      tags: data.tags ?? [],
    };
  });

const entries: FeedEntry[] = [...posts, ...projects].sort(
  (a, b) => new Date(b.date).getTime() - new Date(a.date).getTime(),
);
---

<PageLayout title="Blog" description="Writing and projects from Will Pike.">
  <div class="max-w-3xl mx-auto px-6 py-12">
    <h1 class="text-2xl font-bold text-primary dark:text-white mb-2">Blog</h1>
    <p class="text-sm text-gray-500 dark:text-gray-400 mb-8">
      Notes, tools, and projects
    </p>

    {entries.length === 0 ? (
      <p class="text-sm text-gray-500 dark:text-gray-400">Nothing here yet. Check back soon.</p>
    ) : (
      <div class="flex flex-col gap-4">
        {entries.map((entry: FeedEntry) => (
          <FeedCard
            type={entry.type}
            slug={entry.slug}
            title={entry.title}
            description={entry.description}
            date={entry.date}
            tags={entry.tags}
          />
        ))}
      </div>
    )}
  </div>
</PageLayout>
