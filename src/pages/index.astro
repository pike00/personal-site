---
export const prerender = true;

import { Image } from "astro:assets";
import headshot from "../assets/headshot.jpg";
import PageLayout from "../layouts/PageLayout.astro";
import Container from "../components/Container.astro";
import Button from "../components/Button.astro";
import ProjectCard from "../components/ProjectCard.astro";
import { getPublications } from "../lib/publications";
import { getProjects } from "../lib/posts";
import { getCombinedFeed } from "../lib/feed";
import { personJsonLd } from "../lib/jsonld";

const allProjects = getProjects();
const featuredProjects = ["medpeds", "just-sidebar"]
  .map((slug) => allProjects.find((project) => project.slug === slug))
  .filter((project) => project !== undefined);

const recentNotes = getCombinedFeed()
  .filter((entry) => entry.type === "post")
  .slice(0, 3);
const recentPublications = getPublications().slice(0, 3);

const formatDate = (date: string) =>
  new Date(`${date}T00:00:00`).toLocaleDateString("en-US", {
    month: "short",
    year: "numeric",
  });
---

<PageLayout
  title="Will Pike, MD"
  description="Will Pike, MD, is a physician and clinical AI informaticist at Suki AI. Projects, research, and notes on clinical informatics and real-world evidence."
  image="/og/home.png"
  jsonLd={personJsonLd()}
>
  <Container variant="full">
    <section class="flex min-h-[calc(100svh-4.5rem)] items-center py-8 sm:py-12">
      <div class="grid w-full items-center gap-8 md:grid-cols-[minmax(0,1.35fr)_minmax(16rem,0.8fr)] md:gap-12 lg:gap-20">
        <div class="order-1">
          <h1 class="max-w-[16ch] font-display text-[clamp(3rem,6.2vw,5.5rem)] leading-[0.98] tracking-[-0.035em] text-zinc-900 dark:text-zinc-100">
            I'm a physician working on clinical AI.
          </h1>
          <p class="mt-6 max-w-xl text-lg leading-relaxed text-zinc-600 dark:text-zinc-300">
            At Suki AI, I work as a clinical AI informaticist. My background includes clinical informatics and real-world evidence research, along with software development.
          </p>
          <div class="mt-8 flex flex-wrap gap-3">
            <Button href="/projects/" variant="primary">View work</Button>
            <Button href="/cv/" variant="secondary">Curriculum vitae</Button>
          </div>
          <div class="mt-8 flex gap-6 text-sm font-medium">
            <a href="https://github.com/pike00" target="_blank" rel="noopener noreferrer" class="text-zinc-600 underline decoration-zinc-300 underline-offset-4 transition-colors hover:text-brand-700 dark:text-zinc-300 dark:decoration-zinc-600 dark:hover:text-brand-300">
              GitHub
            </a>
            <a href="https://www.linkedin.com/in/pike00" target="_blank" rel="noopener noreferrer" class="text-zinc-600 underline decoration-zinc-300 underline-offset-4 transition-colors hover:text-brand-700 dark:text-zinc-300 dark:decoration-zinc-600 dark:hover:text-brand-300">
              LinkedIn
            </a>
          </div>
        </div>

        <div class="order-2 mx-auto w-full max-w-[18rem] md:max-w-none">
          <Image
            src={headshot}
            alt="Portrait of Will Pike"
            width={600}
            height={600}
            class="aspect-[4/5] w-full rounded-lg object-cover object-[center_38%]"
          />
        </div>
      </div>
    </section>
  </Container>

  <section class="border-t border-zinc-200/80 py-16 sm:py-24 dark:border-zinc-700/70">
    <Container variant="full">
      <div class="flex items-end justify-between gap-6">
        <h2 class="font-display text-4xl tracking-tight text-zinc-900 sm:text-5xl dark:text-zinc-100">
          Selected work
        </h2>
        <a href="/projects/" class="mb-1 shrink-0 text-sm font-semibold text-brand-700 transition-colors hover:text-brand-800 dark:text-brand-300 dark:hover:text-brand-200">
          All work <span aria-hidden="true">&rarr;</span>
        </a>
      </div>
      <div class="mt-10">
        {featuredProjects.map((project) => <ProjectCard project={project} />)}
      </div>
    </Container>
  </section>

  <section class="border-t border-zinc-200/80 py-16 sm:py-24 dark:border-zinc-700/70">
    <Container variant="full">
      <div class="grid gap-16 lg:grid-cols-2 lg:gap-20">
        <section aria-labelledby="recent-notes-heading">
          <div class="flex items-end justify-between gap-4">
            <h2 id="recent-notes-heading" class="font-display text-3xl tracking-tight text-zinc-900 sm:text-4xl dark:text-zinc-100">
              Recent notes
            </h2>
            <a href="/notes/" class="mb-1 shrink-0 text-sm font-semibold text-brand-700 transition-colors hover:text-brand-800 dark:text-brand-300 dark:hover:text-brand-200">
              All notes <span aria-hidden="true">&rarr;</span>
            </a>
          </div>
          <ol class="mt-8">
            {recentNotes.map((note) => (
              <li class="border-t border-zinc-200/80 py-5 first:border-t-0 first:pt-0 dark:border-zinc-700/70">
                <a href={`/notes/${note.slug}/`} class="group block">
                  <time datetime={note.date} class="text-sm text-zinc-500 dark:text-zinc-400">{formatDate(note.date)}</time>
                  <h3 class="mt-1 text-lg font-semibold leading-snug text-zinc-900 transition-colors group-hover:text-brand-700 dark:text-zinc-100 dark:group-hover:text-brand-300">
                    {note.title}
                  </h3>
                  <p class="mt-2 line-clamp-2 text-sm leading-relaxed text-zinc-600 dark:text-zinc-300">
                    {note.description}
                  </p>
                </a>
              </li>
            ))}
          </ol>
        </section>

        <section aria-labelledby="recent-research-heading">
          <div class="flex items-end justify-between gap-4">
            <h2 id="recent-research-heading" class="font-display text-3xl tracking-tight text-zinc-900 sm:text-4xl dark:text-zinc-100">
              Research
            </h2>
            <a href="/publications/" class="mb-1 shrink-0 text-sm font-semibold text-brand-700 transition-colors hover:text-brand-800 dark:text-brand-300 dark:hover:text-brand-200">
              All publications <span aria-hidden="true">&rarr;</span>
            </a>
          </div>
          <ol class="mt-8">
            {recentPublications.map((publication) => (
              <li class="border-t border-zinc-200/80 py-5 first:border-t-0 first:pt-0 dark:border-zinc-700/70">
                <a href={`/publications/${publication.slug}/`} class="group block">
                  <time datetime={publication.pubDate ?? undefined} class="text-sm text-zinc-500 dark:text-zinc-400">
                    {publication.pubDate ? formatDate(publication.pubDate) : publication.journalAbbrev}
                  </time>
                  <h3 class="mt-1 text-lg font-semibold leading-snug text-zinc-900 transition-colors group-hover:text-brand-700 dark:text-zinc-100 dark:group-hover:text-brand-300">
                    {publication.title}
                  </h3>
                  {publication.journalAbbrev && (
                    <p class="mt-2 text-sm text-zinc-600 dark:text-zinc-300">{publication.journalAbbrev}</p>
                  )}
                </a>
              </li>
            ))}
          </ol>
        </section>
      </div>
    </Container>
  </section>
</PageLayout>
