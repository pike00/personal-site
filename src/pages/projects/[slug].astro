---
export const prerender = true;
import PageLayout from "../../layouts/PageLayout.astro";
import TopicPill from "../../components/TopicPill.astro";
import fs from "node:fs";
import path from "node:path";
import matter from "gray-matter";
import { Marked } from "marked";
import { getPairedPost } from "../../lib/pairings";

interface ProjectFrontmatter {
  title: string;
  description: string;
  url?: string;
  repo?: string;
  tags: string[];
  date: string;
  status?: "active" | "shipped" | "archived";
  period?: string;
  stack?: string[];
  image?: string;
}

interface ProjectData extends ProjectFrontmatter {
  bodyHtml: string;
}

interface StaticPath {
  params: { slug: string };
  props: { project: ProjectData };
}

export async function getStaticPaths(): Promise<StaticPath[]> {
  const projectsDir = path.resolve("src/content/projects");
  const files: string[] = fs
    .readdirSync(projectsDir)
    .filter((f: string) => f.endsWith(".md"));

  // Inline code becomes a click-to-copy pill (styling in global.css, behavior
  // in /js/copy-code.js). Only codespans get the class; fenced blocks don't.
  const marked = new Marked().use({
    renderer: {
      codespan(token) {
        return `<code class="inline-copy" title="Click to copy" role="button" tabindex="0">${token.text}</code>`;
      },
    },
  });

  const paths = await Promise.all(
    files.map(async (file: string): Promise<StaticPath> => {
      const slug = file.replace(/\.md$/, "");
      const raw = fs.readFileSync(path.join(projectsDir, file), "utf-8");
      const { data, content } = matter(raw);
      const bodyHtml = await marked.parse(content);
      return {
        params: { slug },
        props: {
          project: {
            ...(data as ProjectFrontmatter),
            bodyHtml,
          },
        },
      };
    }),
  );
  return paths;
}

interface Props {
  project: ProjectData;
}

const { project } = Astro.props;

const dateDisplay = project.date
  ? new Date(project.date + "T00:00:00").toLocaleDateString("en-US", {
      year: "numeric",
      month: "long",
      day: "numeric",
    })
  : "";

const metaLine = project.period ?? dateDisplay;

const statusClasses: Record<NonNullable<ProjectFrontmatter["status"]>, string> = {
  active: "bg-green-500/10 text-green-700 dark:bg-green-500/20 dark:text-green-300",
  shipped: "bg-accent/10 text-accent dark:bg-accent/20",
  archived: "bg-gray-500/10 text-gray-600 dark:bg-gray-500/20 dark:text-gray-300",
};

const hasBody = project.bodyHtml.trim().length > 0;
const pairedPost = getPairedPost(Astro.params.slug as string);
---

<PageLayout title={project.title} description={project.description} image={`/og/project-${Astro.params.slug}.png`}>
  <div class="max-w-3xl mx-auto px-6 py-12">
    <nav class="text-sm text-gray-400 dark:text-gray-500 mb-8">
      <a href="/" class="hover:text-accent transition-colors">Home</a>
      <span class="mx-2">/</span>
      <span class="text-gray-600 dark:text-gray-300">{project.title}</span>
    </nav>

    <div class="flex items-center gap-3 mb-3">
      <h1 class="text-2xl font-bold text-primary dark:text-white">{project.title}</h1>
      {project.status && (
        <span class={`inline-block text-[10px] font-semibold uppercase tracking-wider px-2 py-0.5 rounded ${statusClasses[project.status]}`}>
          {project.status}
        </span>
      )}
    </div>
    <p class="text-sm text-gray-500 dark:text-gray-400 mb-4">{project.description}</p>

    {metaLine && (
      <p class="text-xs text-gray-400 dark:text-gray-500 mb-6">{metaLine}</p>
    )}

    {project.tags.length > 0 && (
      <div class="flex flex-wrap gap-2 mb-4">
        {project.tags.map((tag: string) => (
          <TopicPill tag={tag} size="sm" />
        ))}
      </div>
    )}

    {project.stack && project.stack.length > 0 && (
      <div class="flex flex-wrap items-center gap-2 mb-6 text-xs text-gray-500 dark:text-gray-400">
        <span class="font-semibold uppercase tracking-wider text-[10px]">Stack</span>
        {project.stack.map((item: string) => (
          <span class="px-2 py-0.5 rounded bg-gray-100 dark:bg-gray-800 text-gray-700 dark:text-gray-300">{item}</span>
        ))}
      </div>
    )}

    {project.image && (
      <img
        src={project.image}
        alt={project.title}
        class="w-full rounded-lg border border-gray-200 dark:border-gray-700 mb-8"
        loading="lazy"
      />
    )}

    {(project.url || project.repo) && (
      <div class="flex flex-wrap gap-3 mb-10">
        {project.url && (
          <a
            href={project.url}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 px-4 py-2 bg-accent hover:bg-accent-dark text-white rounded-lg text-sm font-medium transition-colors"
          >
            Visit site &rarr;
          </a>
        )}
        {project.repo && (
          <a
            href={project.repo}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 px-4 py-2 border border-gray-300 dark:border-gray-600 hover:border-accent text-primary dark:text-gray-100 rounded-lg text-sm font-medium transition-colors"
          >
            View on GitHub &rarr;
          </a>
        )}
      </div>
    )}

    {pairedPost && (
      <aside class="not-prose mb-8 p-4 border-l-4 border-accent bg-accent/5 dark:bg-accent/10 rounded-r-lg">
        <p class="text-[10px] font-semibold uppercase tracking-wider text-accent mb-1">Related post</p>
        <a href={`/notes/${pairedPost.slug}`} class="text-sm font-semibold text-primary dark:text-gray-100 hover:text-accent dark:hover:text-accent transition-colors">
          {pairedPost.title} &rarr;
        </a>
        <p class="text-xs text-gray-500 dark:text-gray-400 mt-1 leading-relaxed">{pairedPost.description}</p>
      </aside>
    )}

    {hasBody && (
      <article
        class="prose prose-sm dark:prose-invert max-w-none prose-headings:text-primary dark:prose-headings:text-white prose-a:text-accent prose-code:before:content-none prose-code:after:content-none"
        set:html={project.bodyHtml}
      />
    )}
  </div>
  <script is:inline src="/js/copy-code.js" defer></script>
</PageLayout>
