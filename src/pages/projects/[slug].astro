---
export const prerender = true;
import PageLayout from "../../layouts/PageLayout.astro";
import Container from "../../components/Container.astro";
import TopicPill from "../../components/TopicPill.astro";
import fs from "node:fs";
import path from "node:path";
import { matter } from "../../lib/frontmatter";
import { Marked } from "marked";
import { getPairedPost } from "../../lib/pairings";

interface ProjectFrontmatter {
  title: string;
  description: string;
  url?: string;
  repo?: string;
  tags: string[];
  date: string;
  status?: "active" | "shipped" | "archived";
  period?: string;
  stack?: string[];
  image?: string;
}

interface ProjectData extends ProjectFrontmatter {
  bodyHtml: string;
}

interface StaticPath {
  params: { slug: string };
  props: { project: ProjectData };
}

export async function getStaticPaths(): Promise<StaticPath[]> {
  const projectsDir = path.resolve("src/content/projects");
  const files: string[] = fs
    .readdirSync(projectsDir)
    .filter((f: string) => f.endsWith(".md"));

  // Inline code becomes a click-to-copy pill (styling in global.css, behavior
  // in /js/copy-code.js). Only codespans get the class; fenced blocks don't.
  const marked = new Marked().use({
    renderer: {
      codespan(token) {
        return `<code class="inline-copy" title="Click to copy" role="button" tabindex="0">${token.text}</code>`;
      },
    },
  });

  const paths = await Promise.all(
    files.map(async (file: string): Promise<StaticPath> => {
      const slug = file.replace(/\.md$/, "");
      const raw = fs.readFileSync(path.join(projectsDir, file), "utf-8");
      const { data, content } = matter(raw);
      const bodyHtml = await marked.parse(content);
      return {
        params: { slug },
        props: {
          project: {
            ...(data as ProjectFrontmatter),
            bodyHtml,
          },
        },
      };
    }),
  );
  return paths;
}

interface Props {
  project: ProjectData;
}

const { project } = Astro.props;

const dateDisplay = project.date
  ? new Date(project.date + "T00:00:00").toLocaleDateString("en-US", {
      year: "numeric",
      month: "long",
      day: "numeric",
    })
  : "";

const metaLine = project.period ?? dateDisplay;

const statusClasses: Record<NonNullable<ProjectFrontmatter["status"]>, string> = {
  active: "bg-green-500/10 text-green-700 dark:bg-green-500/20 dark:text-green-300",
  shipped: "bg-violet-500/10 text-violet-600 dark:bg-violet-400/20 dark:text-violet-300",
  archived: "bg-zinc-500/10 text-zinc-600 dark:bg-zinc-500/20 dark:text-zinc-300",
};

const hasBody = project.bodyHtml.trim().length > 0;
const pairedPost = getPairedPost(Astro.params.slug as string);
---

<PageLayout title={project.title} description={project.description} image={`/og/project-${Astro.params.slug}.png`}>
  <Container variant="full" class="mt-16 lg:mt-32">
    <div class="xl:relative">
      <div class="mx-auto max-w-2xl">
        <a
          href="/notes"
          aria-label="Back to notes"
          class="group mb-8 flex h-10 w-10 items-center justify-center rounded-full bg-white shadow-md ring-1 shadow-zinc-800/5 ring-zinc-900/5 transition lg:absolute lg:-left-5 lg:-mt-2 lg:mb-0 xl:-top-1.5 xl:left-0 xl:mt-0 dark:border dark:border-zinc-700/50 dark:bg-zinc-800 dark:ring-0 dark:ring-white/10 dark:hover:border-zinc-700 dark:hover:ring-white/20"
        >
          <svg viewBox="0 0 16 16" fill="none" aria-hidden="true" class="h-4 w-4 stroke-zinc-500 transition group-hover:stroke-zinc-700 dark:stroke-zinc-500 dark:group-hover:stroke-zinc-400">
            <path d="M7.25 11.25 3.75 8m0 0 3.5-3.25M3.75 8h8.5" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </a>

        <div class="mb-3 flex items-center gap-3">
          <h1 class="text-4xl font-bold tracking-tight text-zinc-800 sm:text-5xl dark:text-zinc-100">{project.title}</h1>
          {project.status && (
            <span class={`inline-block rounded px-2 py-0.5 text-[10px] font-semibold uppercase tracking-wider ${statusClasses[project.status]}`}>
              {project.status}
            </span>
          )}
        </div>
        <p class="mt-2 text-base text-zinc-600 dark:text-zinc-400">{project.description}</p>

        {metaLine && (
          <p class="mt-3 text-sm text-zinc-400 dark:text-zinc-500">{metaLine}</p>
        )}

        {project.tags.length > 0 && (
          <div class="mt-5 flex flex-wrap gap-2">
            {project.tags.map((tag: string) => (
              <TopicPill tag={tag} size="sm" />
            ))}
          </div>
        )}

        {project.stack && project.stack.length > 0 && (
          <div class="mt-6 flex flex-wrap items-center gap-2 text-xs text-zinc-500 dark:text-zinc-400">
            <span class="text-[10px] font-semibold uppercase tracking-wider">Stack</span>
            {project.stack.map((item: string) => (
              <span class="rounded bg-zinc-100 px-2 py-0.5 text-zinc-700 dark:bg-zinc-800 dark:text-zinc-300">{item}</span>
            ))}
          </div>
        )}

        {project.image && (
          <img
            src={project.image}
            alt={project.title}
            class="mt-8 w-full rounded-2xl border border-zinc-100 dark:border-zinc-700/40"
            loading="lazy"
          />
        )}

        {(project.url || project.repo) && (
          <div class="mt-8 flex flex-wrap gap-3">
            {project.url && (
              <a
                href={project.url}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center gap-2 rounded-md bg-zinc-800 px-4 py-2 text-sm font-semibold text-zinc-100 transition hover:bg-zinc-700 dark:bg-zinc-700 dark:hover:bg-zinc-600"
              >
                Visit site &rarr;
              </a>
            )}
            {project.repo && (
              <a
                href={project.repo}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center gap-2 rounded-md bg-zinc-50 px-4 py-2 text-sm font-medium text-zinc-900 transition hover:bg-zinc-100 dark:bg-zinc-800/50 dark:text-zinc-300 dark:hover:bg-zinc-800 dark:hover:text-zinc-50"
              >
                View on GitHub &rarr;
              </a>
            )}
          </div>
        )}

        {pairedPost && (
          <aside class="mt-8 rounded-r-lg border-l-4 border-violet-500 bg-violet-500/5 p-4 dark:border-violet-400 dark:bg-violet-400/10">
            <p class="mb-1 text-[10px] font-semibold uppercase tracking-wider text-violet-600 dark:text-violet-400">Related post</p>
            <a href={`/notes/${pairedPost.slug}`} class="text-sm font-semibold text-zinc-800 transition-colors hover:text-violet-600 dark:text-zinc-100 dark:hover:text-violet-400">
              {pairedPost.title} &rarr;
            </a>
            <p class="mt-1 text-xs leading-relaxed text-zinc-500 dark:text-zinc-400">{pairedPost.description}</p>
          </aside>
        )}

        {hasBody && (
          <article
            class="prose mt-8 max-w-none dark:prose-invert prose-code:before:content-none prose-code:after:content-none"
            set:html={project.bodyHtml}
          />
        )}
      </div>
    </div>
  </Container>
  <script is:inline src="/js/copy-code.js" defer></script>
</PageLayout>
