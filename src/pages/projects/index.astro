---
export const prerender = true;

import PageLayout from "../../layouts/PageLayout.astro";
import SimpleLayout from "../../components/SimpleLayout.astro";
import ProjectCard from "../../components/ProjectCard.astro";
import { getProjects } from "../../lib/posts";

const projects = getProjects().sort((a, b) => b.date.localeCompare(a.date));
---

<PageLayout title="Work" description="Software and tools for clinical work, research, and open-source projects.">
  <SimpleLayout
    title="Work"
    intro="Software and tools for clinical work, research, and open-source projects."
  >
    <div>
      {projects.map((project) => <ProjectCard project={project} />)}
    </div>
    <p class="mt-12 border-t border-zinc-200 pt-6 text-base text-zinc-600 dark:border-zinc-700/60 dark:text-zinc-300">
      More code is listed in <a href="/repos/" class="font-medium text-brand-700 underline decoration-brand-300 underline-offset-4 hover:text-brand-800 dark:text-brand-300 dark:decoration-brand-700 dark:hover:text-brand-200">all repositories</a>.
    </p>
  </SimpleLayout>
</PageLayout>
