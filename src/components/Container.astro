---
/**
 * Spotlight Container — three nested width tiers.
 *
 *   ContainerOuter : sm:px-8, max-w-7xl, lg:px-8   (page gutter)
 *   ContainerInner : px-4 sm:px-8 lg:px-12, max-w-2xl lg:max-w-5xl (content)
 *
 * `Container` (this default) wraps Outer→Inner like the template's <Container>.
 * Use `variant="outer"` or `variant="inner"` to render a single tier (the
 * footer needs them split). Extra classes pass through to the outer element.
 */
interface Props {
  variant?: "full" | "outer" | "inner";
  class?: string;
}

const { variant = "full", class: className = "" } = Astro.props;
---

{
  variant === "outer" && (
    <div class:list={["sm:px-8", className]}>
      <div class="mx-auto w-full max-w-7xl lg:px-8">
        <slot />
      </div>
    </div>
  )
}

{
  variant === "inner" && (
    <div class:list={["relative px-4 sm:px-8 lg:px-12", className]}>
      <div class="mx-auto max-w-2xl lg:max-w-5xl">
        <slot />
      </div>
    </div>
  )
}

{
  variant === "full" && (
    <div class:list={["sm:px-8", className]}>
      <div class="mx-auto w-full max-w-7xl lg:px-8">
        <div class="relative px-4 sm:px-8 lg:px-12">
          <div class="mx-auto max-w-2xl lg:max-w-5xl">
            <slot />
          </div>
        </div>
      </div>
    </div>
  )
}
