---
interface Props {
  value: string | number;
  label: string;
}

const { value, label } = Astro.props;
---

<div class="px-6 py-5 text-center">
  <div class="text-3xl font-bold tracking-tight text-zinc-800 dark:text-zinc-100">{value}</div>
  <div class="mt-1 text-xs uppercase tracking-widest text-zinc-500 dark:text-zinc-400">{label}</div>
</div>
