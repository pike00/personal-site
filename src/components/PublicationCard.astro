---
import TopicPill from "./TopicPill.astro";
import type { Publication } from "../lib/types";
import { highlightAuthors } from "../lib/authors";

interface Props {
  publication: Publication;
}

const { publication: pub } = Astro.props;

const authorDisplay = highlightAuthors(pub.authors);

const year = pub.pubDate ? pub.pubDate.split("-")[0] : "";
const journalLine = [pub.journalAbbrev, year].filter(Boolean).join(", ");
---

<a href={`/publications/${pub.slug}`} class="group block">
  <div class="rounded-2xl border border-l-[3px] border-zinc-100 border-l-violet-500 p-5 transition hover:border-zinc-200 hover:bg-zinc-50/60 dark:border-zinc-700/40 dark:border-l-violet-400 dark:hover:border-zinc-700 dark:hover:bg-zinc-800/40">
    <div class="space-y-2">
      <h3 class="text-sm font-semibold leading-snug text-zinc-800 transition-colors group-hover:text-violet-600 dark:text-zinc-100 dark:group-hover:text-violet-400">
        {pub.title}
      </h3>
      {pub.authors.length > 0 && (
        <p class="text-xs text-zinc-500 dark:text-zinc-400" set:html={authorDisplay} />
      )}
      {journalLine && (
        <p class="text-xs text-zinc-400 dark:text-zinc-500">{journalLine}</p>
      )}
      {pub.researchArea.length > 0 && (
        <div class="flex flex-wrap gap-1.5 pt-1">
          {pub.researchArea.map((tag) => (
            <TopicPill tag={tag} size="sm" />
          ))}
        </div>
      )}
    </div>
  </div>
</a>
