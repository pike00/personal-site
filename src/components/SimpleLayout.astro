---
import Container from "./Container.astro";

/** Shared heading and content frame for list pages. */
interface Props {
  title: string;
  intro?: string;
}

const { title, intro } = Astro.props;
---

<Container variant="full" class="mt-14 sm:mt-20">
  <header class="max-w-3xl">
    <h1 class="font-display text-5xl font-normal leading-tight tracking-tight text-zinc-900 sm:text-6xl dark:text-zinc-100">
      {title}
    </h1>
    {intro && (
      <p class="mt-5 max-w-2xl text-lg leading-relaxed text-zinc-600 dark:text-zinc-300">{intro}</p>
    )}
  </header>
  <div class="mt-12 sm:mt-16">
    <slot />
  </div>
</Container>
