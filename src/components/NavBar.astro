---
import { Image } from "astro:assets";
import DarkModeToggle from "./DarkModeToggle.astro";
import Container from "./Container.astro";
import avatar from "../assets/headshot.jpg";
import { flags } from "../lib/flags";

const allLinks = [
  { href: "/cv", label: "CV" },
  { href: "/publications", label: "Publications" },
  { href: "/notes", label: "Notes" },
  { href: "/prints", label: "3D Prints" },
  { href: "/topics", label: "Topics" },
  { href: "/about", label: "About" },
  { href: "/contact", label: "Contact", flag: "contact" as const },
];

const links = allLinks.filter((l) => !l.flag || flags[l.flag]);

const currentPath = Astro.url.pathname;
const isHome = currentPath === "/";

const isActive = (href: string) =>
  currentPath === href || (href !== "/" && currentPath.startsWith(href));
---

{/* Spotlight floating header: pointer-events-none shell, pointer-events-auto
    on the interactive pills. Sticky at the top of the page. */}
<header class="pointer-events-none relative z-50 flex flex-none flex-col">
  <div class="sticky top-0 z-10 h-16 pt-6">
    <Container variant="full" class="top-6 w-full">
      <div class="relative flex gap-4">
        {/* Left: avatar (hidden on home, where the hero carries it) */}
        <div class="flex flex-1">
          {!isHome && (
            <div class="pointer-events-auto h-10 w-10 rounded-full bg-white/90 p-0.5 shadow-lg ring-1 shadow-zinc-800/5 ring-zinc-900/5 backdrop-blur-sm dark:bg-zinc-800/90 dark:ring-white/10">
              <a href="/" aria-label="Home" class="block">
                <Image
                  src={avatar}
                  alt="Will Pike"
                  width={72}
                  height={72}
                  class="h-9 w-9 rounded-full bg-zinc-100 object-cover dark:bg-zinc-800"
                />
              </a>
            </div>
          )}
        </div>

        {/* Center: navigation */}
        <div class="flex flex-1 justify-end md:justify-center">
          {/* Mobile menu button */}
          <div class="pointer-events-auto md:hidden">
            <button
              id="mobile-menu-btn"
              type="button"
              class="group flex items-center rounded-full bg-white/90 px-4 py-2 text-sm font-medium text-zinc-800 shadow-lg ring-1 shadow-zinc-800/5 ring-zinc-900/5 backdrop-blur-sm dark:bg-zinc-800/90 dark:text-zinc-200 dark:ring-white/10 dark:hover:ring-white/20"
            >
              Menu
              <svg viewBox="0 0 8 6" aria-hidden="true" class="ml-3 h-auto w-2 stroke-zinc-500 group-hover:stroke-zinc-700 dark:group-hover:stroke-zinc-400">
                <path d="M1.75 1.75 4 4.25l2.25-2.5" fill="none" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            </button>
          </div>

          {/* Desktop pill nav */}
          <nav class="pointer-events-auto hidden md:block">
            <ul class="flex rounded-full bg-white/90 px-3 text-sm font-medium text-zinc-800 shadow-lg ring-1 shadow-zinc-800/5 ring-zinc-900/5 backdrop-blur-sm dark:bg-zinc-800/90 dark:text-zinc-200 dark:ring-white/10">
              {links.map((link) => (
                <li>
                  <a
                    href={link.href}
                    class:list={[
                      "relative block px-3 py-2 whitespace-nowrap transition",
                      isActive(link.href)
                        ? "text-violet-500 dark:text-violet-400"
                        : "hover:text-violet-500 dark:hover:text-violet-400",
                    ]}
                  >
                    {link.label}
                    {isActive(link.href) && (
                      <span class="absolute inset-x-1 -bottom-px h-px bg-gradient-to-r from-violet-500/0 via-violet-500/40 to-violet-500/0 dark:from-violet-400/0 dark:via-violet-400/40 dark:to-violet-400/0" />
                    )}
                  </a>
                </li>
              ))}
            </ul>
          </nav>
        </div>

        {/* Right: search, socials, theme toggle */}
        <div class="flex justify-end md:flex-1">
          <div class="pointer-events-auto flex items-center gap-2">
            <button
              type="button"
              data-open-search
              aria-label="Search (Command or Control + K)"
              class="group flex h-10 w-10 items-center justify-center rounded-full bg-white/90 shadow-lg ring-1 shadow-zinc-800/5 ring-zinc-900/5 backdrop-blur-sm transition hover:ring-zinc-900/10 dark:bg-zinc-800/90 dark:ring-white/10 dark:hover:ring-white/20"
            >
              <svg class="h-5 w-5 stroke-zinc-500 transition group-hover:stroke-zinc-700 dark:stroke-zinc-400 dark:group-hover:stroke-zinc-200" fill="none" viewBox="0 0 24 24" stroke-width="1.8">
                <path d="M21 21l-4.35-4.35M17 11a6 6 0 11-12 0 6 6 0 0112 0z" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            </button>

            <a
              href="https://github.com/pike00"
              target="_blank"
              rel="noopener noreferrer"
              aria-label="GitHub"
              class="group hidden h-10 w-10 items-center justify-center rounded-full bg-white/90 shadow-lg ring-1 shadow-zinc-800/5 ring-zinc-900/5 backdrop-blur-sm transition hover:ring-zinc-900/10 sm:flex dark:bg-zinc-800/90 dark:ring-white/10 dark:hover:ring-white/20"
            >
              <svg class="h-5 w-5 fill-zinc-500 transition group-hover:fill-zinc-700 dark:fill-zinc-400 dark:group-hover:fill-zinc-200" viewBox="0 0 24 24"><path d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"/></svg>
            </a>

            <a
              href="https://www.linkedin.com/in/pike00"
              target="_blank"
              rel="noopener noreferrer"
              aria-label="LinkedIn"
              class="group hidden h-10 w-10 items-center justify-center rounded-full bg-white/90 shadow-lg ring-1 shadow-zinc-800/5 ring-zinc-900/5 backdrop-blur-sm transition hover:ring-zinc-900/10 sm:flex dark:bg-zinc-800/90 dark:ring-white/10 dark:hover:ring-white/20"
            >
              <svg class="h-5 w-5 fill-zinc-500 transition group-hover:fill-zinc-700 dark:fill-zinc-400 dark:group-hover:fill-zinc-200" viewBox="0 0 24 24"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
            </a>

            <DarkModeToggle />
          </div>
        </div>
      </div>
    </Container>
  </div>
</header>

{/* Mobile slide-down menu (toggled by #mobile-menu-btn) */}
<div id="mobile-menu" class="pointer-events-auto fixed inset-x-4 top-8 z-50 hidden origin-top rounded-3xl bg-white p-8 ring-1 ring-zinc-900/5 md:hidden dark:bg-zinc-900 dark:ring-zinc-800">
  <div class="flex flex-row-reverse items-center justify-between">
    <button id="mobile-menu-close" type="button" aria-label="Close menu" class="-m-1 p-1">
      <svg viewBox="0 0 24 24" class="h-6 w-6 text-zinc-500 dark:text-zinc-400">
        <path d="m17.25 6.75-10.5 10.5M6.75 6.75l10.5 10.5" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
      </svg>
    </button>
    <h2 class="text-sm font-medium text-zinc-600 dark:text-zinc-400">Navigation</h2>
  </div>
  <nav class="mt-6">
    <ul class="-my-2 divide-y divide-zinc-100 text-base text-zinc-800 dark:divide-zinc-100/5 dark:text-zinc-300">
      <li><a href="/" class="block py-2">Home</a></li>
      {links.map((link) => (
        <li><a href={link.href} class="block py-2">{link.label}</a></li>
      ))}
    </ul>
  </nav>
</div>

<script is:inline src="/scripts/mobile-menu.js" defer></script>
