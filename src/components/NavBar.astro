---
import DarkModeToggle from "./DarkModeToggle.astro";
import Container from "./Container.astro";
import { flags } from "../lib/flags";

const links = [
  { href: "/projects/", label: "Work" },
  { href: "/publications/", label: "Publications" },
  { href: "/notes/", label: "Notes" },
  { href: "/cv/", label: "CV" },
  { href: "/about/", label: "About" },
  ...(flags.contact ? [{ href: "/contact/", label: "Contact" }] : []),
];

const currentPath = Astro.url.pathname;
const isActive = (href: string) =>
  currentPath === href || (href !== "/" && currentPath.startsWith(href));
---

<header class="sticky top-0 z-50 border-b border-zinc-200/80 bg-paper-card/95 backdrop-blur dark:border-zinc-700/70 dark:bg-night-card/95">
  <Container variant="full">
    <div class="flex min-h-[4.5rem] items-center justify-between gap-6">
      <a href="/" class="shrink-0 text-base font-semibold tracking-tight text-zinc-900 dark:text-zinc-100">
        Will Pike<span class="font-normal text-zinc-500 dark:text-zinc-400">, MD</span>
      </a>

      <nav aria-label="Primary" class="hidden md:block">
        <ul class="flex items-center gap-6 text-sm font-medium">
          {links.map((link) => {
            const active = isActive(link.href);
            return (
              <li>
                <a
                  href={link.href}
                  aria-current={active ? "page" : undefined}
                  class:list={[
                    "transition-colors",
                    active
                      ? "text-brand-700 dark:text-brand-300"
                      : "text-zinc-600 hover:text-zinc-950 dark:text-zinc-300 dark:hover:text-white",
                  ]}
                >
                  {link.label}
                </a>
              </li>
            );
          })}
        </ul>
      </nav>

      <div class="flex shrink-0 items-center gap-2">
        <button
          type="button"
          data-open-search
          aria-label="Search (Command or Control + K)"
          class="flex h-10 w-10 items-center justify-center rounded-md border border-zinc-200 text-zinc-600 transition-colors hover:border-zinc-400 hover:text-zinc-950 dark:border-zinc-700 dark:text-zinc-300 dark:hover:border-zinc-500 dark:hover:text-white"
        >
          <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
            <path d="M21 21l-4.35-4.35M17 11a6 6 0 11-12 0 6 6 0 0112 0z" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </button>

        <a
          href="https://github.com/pike00"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="GitHub profile"
          class="hidden h-10 w-10 items-center justify-center rounded-md border border-zinc-200 text-zinc-600 transition-colors hover:border-zinc-400 hover:text-zinc-950 sm:flex dark:border-zinc-700 dark:text-zinc-300 dark:hover:border-zinc-500 dark:hover:text-white"
        >
          <svg class="h-5 w-5 fill-current" viewBox="0 0 24 24" aria-hidden="true">
            <path d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" />
          </svg>
        </a>

        <DarkModeToggle />

        <button
          id="mobile-menu-btn"
          type="button"
          aria-controls="mobile-menu"
          aria-expanded="false"
          class="rounded-md border border-zinc-200 px-3 py-2 text-sm font-medium text-zinc-700 transition-colors hover:border-zinc-400 md:hidden dark:border-zinc-700 dark:text-zinc-200 dark:hover:border-zinc-500"
        >
          Menu
        </button>
      </div>
    </div>
  </Container>
</header>

<div
  id="mobile-menu"
  class="fixed inset-x-4 top-[4.5rem] z-50 hidden rounded-lg border border-zinc-200 bg-paper-card p-5 shadow-xl md:hidden dark:border-zinc-700 dark:bg-night-card"
>
  <div class="flex items-center justify-between">
    <h2 class="text-sm font-semibold text-zinc-800 dark:text-zinc-100">Navigation</h2>
    <button id="mobile-menu-close" type="button" aria-label="Close menu" class="rounded p-1 text-zinc-500 hover:text-zinc-900 dark:text-zinc-400 dark:hover:text-white">
      <svg viewBox="0 0 24 24" class="h-5 w-5" aria-hidden="true">
        <path d="m17.25 6.75-10.5 10.5M6.75 6.75l10.5 10.5" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
      </svg>
    </button>
  </div>
  <nav aria-label="Mobile" class="mt-3">
    <ul class="divide-y divide-zinc-200/80 text-base dark:divide-zinc-700/70">
      {links.map((link) => (
        <li>
          <a href={link.href} class="block py-3 text-zinc-800 hover:text-brand-700 dark:text-zinc-200 dark:hover:text-brand-300">
            {link.label}
          </a>
        </li>
      ))}
    </ul>
  </nav>
</div>

<script is:inline src="/scripts/mobile-menu.js" defer></script>
