---
/** Renders an anchor when `href` is set, otherwise a button. */
interface Props {
  href?: string;
  variant?: "primary" | "secondary";
  type?: "button" | "submit" | "reset";
  class?: string;
  [key: string]: unknown;
}

const {
  href,
  variant = "primary",
  type = "button",
  class: className = "",
  ...rest
} = Astro.props;

const variantStyles = {
  primary:
    "bg-brand-700 font-semibold text-white hover:bg-brand-800 active:bg-brand-800 active:text-white/80 dark:bg-brand-400 dark:text-zinc-950 dark:hover:bg-brand-300 dark:active:bg-brand-300 dark:active:text-zinc-950/80",
  secondary:
    "bg-stone-100 font-medium text-zinc-900 hover:bg-stone-200 active:bg-stone-200 active:text-zinc-900/70 dark:bg-zinc-800 dark:text-zinc-200 dark:hover:bg-zinc-700 dark:hover:text-white dark:active:bg-zinc-700 dark:active:text-white/80",
};

const base =
  "inline-flex items-center justify-center gap-2 rounded-md px-3 py-2 text-sm outline-offset-2 transition active:transition-none";
const classes = [base, variantStyles[variant], className];
---

{
  href ? (
    <a href={href} class:list={classes} {...rest}>
      <slot />
    </a>
  ) : (
    <button type={type} class:list={classes} {...rest}>
      <slot />
    </button>
  )
}
