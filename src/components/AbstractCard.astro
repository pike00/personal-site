---
import type { Abstract } from "../lib/types";

interface Props {
  abstract: Abstract;
}

const { abstract: abs } = Astro.props;
---

<div class="rounded-2xl border border-zinc-100 p-5 transition hover:bg-zinc-50/60 dark:border-zinc-700/40 dark:hover:bg-zinc-800/40">
  <div class="flex items-start justify-between gap-3">
    <div class="min-w-0 flex-1">
      <h3 class="text-sm font-semibold leading-snug text-zinc-800 dark:text-zinc-100">
        {abs.title}
      </h3>
      {abs.hook && (
        <p class="mt-1.5 text-sm leading-snug text-zinc-600 dark:text-zinc-300">{abs.hook}</p>
      )}
      {abs.abstractId && (
        <p class="mt-1 text-xs text-zinc-400 dark:text-zinc-500">Abstract #{abs.abstractId}</p>
      )}
    </div>
    <div class="flex shrink-0 items-center gap-2">
      {abs.unpublished && (
        <span class="rounded-full bg-amber-50 px-2.5 py-0.5 text-xs font-medium text-amber-700 dark:bg-amber-950 dark:text-amber-400">
          Unpublished
        </span>
      )}
      {abs.pdfPath && (
        <a
          href={`/${abs.pdfPath}`}
          target="_blank"
          rel="noopener noreferrer"
          class="text-xs font-medium text-violet-600 hover:text-violet-700 dark:text-violet-400 dark:hover:text-violet-300"
        >
          PDF
        </a>
      )}
    </div>
  </div>

  {(abs.summary || abs.abstract) && (
    <details class="group mt-3">
      <summary class="inline-flex cursor-pointer list-none items-center gap-1 text-xs font-medium text-violet-600 hover:text-violet-700 dark:text-violet-400 dark:hover:text-violet-300 [&::-webkit-details-marker]:hidden">
        <span class="group-open:hidden">Read summary</span>
        <span class="hidden group-open:inline">Hide</span>
        <svg class="h-3 w-3 transition-transform duration-200 group-open:rotate-180" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path d="M19 9l-7 7-7-7" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
      </summary>
      {abs.summary && (
        <p class="mt-2 text-sm leading-relaxed text-zinc-600 dark:text-zinc-400">{abs.summary}</p>
      )}
      {abs.abstract && (
        <p class="mt-3 text-sm leading-relaxed whitespace-pre-line text-zinc-500 dark:text-zinc-500">{abs.abstract}</p>
      )}
    </details>
  )}
</div>
