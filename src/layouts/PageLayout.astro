---
import BaseLayout from "./BaseLayout.astro";
import NavBar from "../components/NavBar.astro";
import Footer from "../components/Footer.astro";
import CommandPalette from "../components/CommandPalette";
import DocSearchPalette from "../components/DocSearchPalette";
import { buildGlobalIndex } from "../lib/search";
import { flags } from "../lib/flags";

const useDocSearch = flags.search === "docsearch";
// Skip building the Fuse index entirely when DocSearch owns search.
const searchIndex = useDocSearch ? [] : buildGlobalIndex();

interface Props {
  title: string;
  description: string;
  image?: string;
  type?: string;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
}

const { title, description, image, type, jsonLd } = Astro.props;
---

<BaseLayout title={title} description={description} image={image} type={type} jsonLd={jsonLd}>
  <NavBar />
  <main class="flex-1">
    <slot />
  </main>
  <Footer />
  {useDocSearch
    ? <DocSearchPalette client:idle />
    : <CommandPalette client:idle index={searchIndex} />}
</BaseLayout>
