---
import BaseLayout from "./BaseLayout.astro";
import NavBar from "../components/NavBar.astro";
import Footer from "../components/Footer.astro";
import CommandPalette from "../components/CommandPalette";
import DocSearchPalette from "../components/DocSearchPalette";
import { buildGlobalIndex } from "../lib/search";
import { flags } from "../lib/flags";

const useDocSearch = flags.search === "docsearch";
// Skip building the Fuse index entirely when DocSearch owns search.
const searchIndex = useDocSearch ? [] : buildGlobalIndex();

interface Props {
  title: string;
  description: string;
  image?: string;
  type?: string;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
}

const { title, description, image, type, jsonLd } = Astro.props;
---

<BaseLayout title={title} description={description} image={image} type={type} jsonLd={jsonLd}>
  {/* Centered page surface on the warm neutral canvas. */}
  <div class="fixed inset-0 flex justify-center sm:px-8">
    <div class="flex w-full max-w-7xl lg:px-8">
      <div class="w-full bg-paper-card ring-1 ring-zinc-200/70 dark:bg-night-card dark:ring-zinc-700/60"></div>
    </div>
  </div>

  <div class="relative flex w-full flex-col">
    <NavBar />
    <main class="flex-auto">
      <slot />
    </main>
    <Footer />
  </div>

  {useDocSearch
    ? <DocSearchPalette client:idle />
    : <CommandPalette client:idle index={searchIndex} />}
</BaseLayout>
