{
	admin off
	persist_config off
	auto_https off
}

:8080 {
	root * /srv
	encode zstd gzip
	file_server

	handle_errors {
		rewrite * /{err.status_code}.html
		file_server
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Frame-Options "SAMEORIGIN"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "geolocation=(), microphone=(), camera=()"
		Content-Security-Policy "default-src 'self'; script-src 'self' 'sha256-NfE2NJ8c6rxrl2a9QzSdkbGBfCEsVstqR17WOAyGhfk=' 'sha256-QzWFZi+FLIx23tnm9SBU4aEgx4x8DsuASP07mfqol/c=' 'sha256-BrDhGE1lwa85arfXcrBxSo+n37uVSX5CAROXnIM6Q+g=' 'sha256-Bjx/cM+W6KYSq/DA7fmUGp9VwehVrZbEE5PVTJMimJ0=' https://umami.khanpikehome.com; connect-src 'self' https://umami.khanpikehome.com; style-src 'self' 'unsafe-inline' https://rsms.me; img-src 'self' data:; font-src 'self' https://rsms.me; frame-ancestors 'self'"
	}
}
