{
	admin off
	persist_config off
	auto_https off
}

:8080 {
	root * /srv
	encode zstd gzip
	file_server

	handle_errors {
		rewrite * /{err.status_code}.html
		file_server
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Frame-Options "SAMEORIGIN"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "geolocation=(), microphone=(), camera=()"
		Content-Security-Policy "default-src 'self'; script-src 'self' 'sha256-BF0290pkb3jxQsE7z00xR8Imp8X34FLC88L0lkMnrGw=' 'sha256-NfE2NJ8c6rxrl2a9QzSdkbGBfCEsVstqR17WOAyGhfk=' 'sha256-QzWFZi+FLIx23tnm9SBU4aEgx4x8DsuASP07mfqol/c=' 'sha256-SaCkFfPruIdTXT8/97JArQmGxiJAL2o4bBDvSgJ5y3Q=' https://umami.khanpikehome.com https://challenges.cloudflare.com; connect-src 'self' https://umami.khanpikehome.com https://challenges.cloudflare.com https://*.algolia.net https://*.algolianet.com https://*.algolia.io; style-src 'self' 'unsafe-inline' https://rsms.me; img-src 'self' data:; font-src 'self' https://rsms.me; frame-src 'self' https://challenges.cloudflare.com; frame-ancestors 'self'"
	}
}
